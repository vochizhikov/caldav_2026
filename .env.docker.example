# Create .env.docker from this template; never put real secrets in the image.
BOT_TOKEN=123456789:replace_with_bot_token
# Reuse the ORIGINAL key when migrating an existing database.
# For a new database: docker run --rm yandex-calendar-bot:latest python -m bot.generate_key
ENCRYPTION_KEY=replace_with_generated_fernet_key
DATABASE_URL=sqlite+aiosqlite:////data/calendar_bot.db
DEFAULT_TIMEZONE=Europe/Moscow
SYNC_INTERVAL_SECONDS=60
NOTIFIER_INTERVAL_SECONDS=5
CALDAV_TIMEOUT_SECONDS=20
REMINDER_GRACE_SECONDS=90
EVENT_HORIZON_DAYS=45
ADMIN_IDS=[74529696]
AUDIT_ENABLED=true
AUDIT_ADMIN_IDS=[74529696]
AUDIT_DIRECTORY=/data/audit
AUDIT_BATCH_SECONDS=60
AUDIT_RETENTION_DAYS=3
AUDIT_MAX_DISK_MB=128
# Optional independent Fernet key; otherwise derived from ENCRYPTION_KEY.
# AUDIT_ENCRYPTION_KEY=replace_with_generated_fernet_key
