# Telegram token from @BotFather
BOT_TOKEN=123456789:replace_with_bot_token
# Generate once: python -m bot.generate_key
ENCRYPTION_KEY=replace_with_generated_fernet_key
DATABASE_URL=sqlite+aiosqlite:///./calendar_bot.db
DEFAULT_TIMEZONE=Europe/Moscow
SYNC_INTERVAL_SECONDS=60
NOTIFIER_INTERVAL_SECONDS=5
CALDAV_TIMEOUT_SECONDS=20
REMINDER_GRACE_SECONDS=90
EVENT_HORIZON_DAYS=45
# Optional Telegram user IDs, JSON array:
ADMIN_IDS=[74529696]
# Optional admin monitor. Bind with /monitor_setup in a forum group.
MONITOR_ENABLED=true
MONITOR_ADMIN_IDS=[74529696]
MONITOR_DIRECTORY=data/monitoring
MONITOR_ERROR_REPEAT_SECONDS=300
MONITOR_MAX_PENDING=10000
